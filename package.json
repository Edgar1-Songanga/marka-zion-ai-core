{
  "name": "@marka-zion/ai-core",
  "version": "0.1.0",
  "private": true,
  "description": "Independent AI Core for ZION, MARKA and future products.",
  "scripts": {
    "build": "nest build && node scripts/copy-migrations.cjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/src/worker.js",
    "db:migrate": "node dist/src/infrastructure/postgres/migrate.js",
    "test": "npm run build && node --test \"dist/src/**/*.spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@vercel/oidc": "^4.0.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "multer": "^2.5.0",
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
