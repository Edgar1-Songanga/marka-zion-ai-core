NODE_ENV=development
PORT=3000
SERVICE_NAME=marka-zion-ai-core

# Required in production. Never commit the real value.
AI_CORE_API_KEY=

# PostgreSQL / Supabase
DATABASE_URL=
DATABASE_SSL=true
# Vercel/serverless: Supabase transaction pooler (port 6543); pool size stays small.
DATABASE_POOL_MAX=1

# AI provider
# Vercel Functions resolve request-scoped OIDC through @vercel/oidc.
# Outside Vercel, configure AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Open-weight multilingual model; production routing is restricted to Amazon Bedrock.
AI_MODEL=meta/llama-3.1-8b
AI_MAX_OUTPUT_TOKENS=1024

# Request protection
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARACTERS=20000
AI_MAX_TOOL_OUTPUT_CHARACTERS=50000
AI_REQUESTS_PER_MINUTE=30
AI_TOKENS_PER_DAY=500000
AI_WORKER_QUEUE=default
AI_CONTEXT_SIGNING_SECRET=
AI_MAX_GROUNDING_CHARACTERS=30000
AI_MAX_PROVIDER_RESPONSE_CHARACTERS=2000000
AI_CONNECTOR_TIMEOUT_MS=10000
AI_CONNECTOR_MAX_RESPONSE_BYTES=1000000

AI_ZION_CONNECTOR_ENABLED=false
AI_ZION_BASE_URL=
AI_ZION_SERVICE_TOKEN=
AI_ZION_OPERATIONS_JSON={}

AI_MARKA_CONNECTOR_ENABLED=false
AI_MARKA_BASE_URL=
AI_MARKA_SERVICE_TOKEN=
AI_MARKA_OPERATIONS_JSON={}
AI_JOB_LEASE_MS=300000
AI_MAX_AGENT_STEPS=8
AI_MAX_TOOL_CALLS_PER_STEP=8
AI_ALLOWED_CONTEXT_ISSUERS=zion-api,marka-api
AI_OWNER_CONTEXT_ISSUERS=platform-identity
AI_CONTEXT_AUDIENCE=ai-core
DATABASE_SSL_REJECT_UNAUTHORIZED=true

AI_MISSION_TASK_LEASE_MS=300000
