NODE_ENV=development
PORT=3000
SERVICE_NAME=marka-zion-ai-core

# Required in production. Never commit the real value.
AI_CORE_API_KEY=

# PostgreSQL / Supabase
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# AI provider
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=openai/gpt-5.6-sol

# Request protection
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARACTERS=20000
AI_MAX_TOOL_OUTPUT_CHARACTERS=50000
AI_REQUESTS_PER_MINUTE=60
AI_TOKENS_PER_DAY=2000000
AI_WORKER_QUEUE=default
AI_CONTEXT_SIGNING_SECRET=
AI_MAX_GROUNDING_CHARACTERS=30000
