{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "infrastructure/postgres/migrations/**/*.sql",
        "outDir": "dist/infrastructure/postgres/migrations",
        "watchAssets": true
      }
    ]
  }
}
